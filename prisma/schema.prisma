generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  roleName      String         @default("User") // "Super Admin" | "Manager" | "Editor" | "Viewer"
  permissions   Int            @default(1) // Discord-style bitfield flags (Int supports 31 bit flags)
  avatarUrl     String?
  extensionToken String?  @unique // Hashed browser-login token for the authoring Chrome extension
  departmentId  String?
  department    Department?    @relation(fields: [departmentId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  processes            Process[]            @relation("CreatedProcesses")
  savedSessions        SavedSession[]
  informationPosts     InformationPost[]    @relation("CreatedInformationPosts")
  receivedAccessGrants     ProcessAccessGrant[]     @relation("GrantedToUser")
  createdAccessGrants      ProcessAccessGrant[]     @relation("GrantedByUser")
  receivedInfoAccessGrants InformationAccessGrant[] @relation("InfoGrantedToUser")
  createdInfoAccessGrants  InformationAccessGrant[] @relation("InfoGrantedByUser")
  operatedRuns             WorkflowRun[]            @relation("RunOperator")
  supervisedRuns           WorkflowRun[]            @relation("RunSupervisor")
}

model Department {
  id               String                   @id @default(uuid())
  name             String
  slug             String                   @unique
  icon             String?
  createdAt        DateTime                 @default(now())
  users            User[]
  processes        Process[]
  informationPosts InformationPost[]
  accessGrants     ProcessAccessGrant[]
  infoAccessGrants InformationAccessGrant[]
}

model SystemTool {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  category         String    // software, devtools, erp, portal
  icon             String?
  description      String?
  websiteUrl       String?
  createdAt        DateTime          @default(now())
  processes        Process[]
  informationPosts InformationPost[]
}

model Process {
  id               String               @id @default(uuid())
  title            String
  slug             String               @unique
  description      String
  scope            String               @default("organization") // organization | software | portal
  category         String
  visibility       String               @default("public") // "public" | "restricted"
  departmentId     String?
  department       Department?          @relation(fields: [departmentId], references: [id])
  systemToolId     String?
  systemTool       SystemTool?          @relation(fields: [systemToolId], references: [id])
  authorId         String?
  author           User?                @relation("CreatedProcesses", fields: [authorId], references: [id])
  estimatedMinutes Int                  @default(10)
  targetSystem     String?
  targetUrl        String?
  schedule         Json?                // Operational calendar & deadline schedule
  isPublished      Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  steps            Step[]
  savedSessions    SavedSession[]
  accessGrants     ProcessAccessGrant[]
  workflowRuns     WorkflowRun[]
  parentSteps      Step[]               @relation("StepSubProcess")
}

model ProcessAccessGrant {
  id             String      @id @default(uuid())
  processId      String
  process        Process     @relation(fields: [processId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?       @relation("GrantedToUser", fields: [userId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  roleName       String?
  claimToken     String?     @unique
  claimExpiresAt DateTime?
  permission     String      @default("view") // "view" | "edit"
  grantedById    String?
  grantedBy      User?       @relation("GrantedByUser", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())

  @@index([processId])
  @@index([userId])
  @@index([departmentId])
  @@index([roleName])
}

model Step {
  id              String       @id @default(uuid())
  processId       String
  process         Process      @relation(fields: [processId], references: [id], onDelete: Cascade)
  orderIndex      Int
  stepKey         String
  title           String
  contentMarkdown String
  stepType        String       @default("action") // action, decision, warning, end
  targetMenuPath  String?
  imageUrl        String?
  hotspots        Json?        // Coordinates and labels on screenshots
  copyableFields  Json?        // Helper sample data to copy
  uiSnippets      Json?        // Micro UI click elements and icons (WebP)
  positionX       Float        @default(0)
  positionY       Float        @default(0)
  errorGuides     ErrorGuide[]
  subProcessId    String?
  subProcessSlug  String?
  subProcess      Process?     @relation("StepSubProcess", fields: [subProcessId], references: [id], onDelete: SetNull)

  @@index([subProcessId])
}

model ErrorGuide {
  id               String  @id @default(uuid())
  stepId           String
  step             Step    @relation(fields: [stepId], references: [id], onDelete: Cascade)
  errorCode        String
  errorTitle       String
  solutionMarkdown String
  screenshotUrl    String?
}

model SavedSession {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  processId      String
  process        Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  currentStepKey String?
  scratchpadData Json?
  completedSteps Json?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

model InformationPost {
  id           String      @id @default(uuid())
  title        String
  slug         String      @unique
  summary      String?
  content      String      // Markdown & multiline content
  type         String      @default("announcement") // announcement, circular, guide, article
  priority     String      @default("normal")       // urgent, high, normal
  isPinned     Boolean     @default(false)
  isPublished  Boolean     @default(true)
  visibility   String      @default("public") // "public" | "restricted"
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  systemToolId String?
  systemTool   SystemTool? @relation(fields: [systemToolId], references: [id])
  authorId     String?
  author       User?       @relation("CreatedInformationPosts", fields: [authorId], references: [id])
  targetUrl    String?
  publishedAt  DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  accessGrants InformationAccessGrant[]
}

model ProcessScope {
  id          String            @id @default(uuid())
  key         String            @unique // e.g. "organization", "software", "portal"
  name        String            // e.g. "سازمانی و مراجع دولتی"
  description String?
  icon        String?
  orderIndex  Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  categories  ProcessCategory[]
}

model ProcessCategory {
  id          String        @id @default(uuid())
  key         String        // e.g. "hr", "finance", "it"
  name        String        // e.g. "منابع انسانی و کارگزینی"
  description String?
  icon        String?
  orderIndex  Int           @default(0)
  scopeId     String?       // null = Applies to ALL scopes (دسته‌بندی عمومی - همه حوزه‌ها)
  scope       ProcessScope? @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model InformationAccessGrant {
  id             String          @id @default(uuid())
  postId         String
  post           InformationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?           @relation("InfoGrantedToUser", fields: [userId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  roleName       String?
  claimToken     String?         @unique
  claimExpiresAt DateTime?
  permission     String          @default("view") // "view" | "edit"
  grantedById    String?
  grantedBy      User?           @relation("InfoGrantedByUser", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())

  @@index([postId])
  @@index([userId])
  @@index([departmentId])
  @@index([roleName])
}

model WorkflowRun {
  id                       String            @id @default(uuid())
  processId                String
  process                  Process           @relation(fields: [processId], references: [id], onDelete: Cascade)
  runNumber                Int               @default(1)
  title                    String
  status                   String            @default("in_progress") // "in_progress" | "completed" | "paused" | "flagged"
  operatorId               String?
  operator                 User?             @relation("RunOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  operatorName             String
  operatorRole             String?
  startedAt                DateTime          @default(now())
  completedAt              DateTime?
  totalDurationSeconds     Int?
  completedStepsCount      Int               @default(0)
  totalStepsCount          Int               @default(0)
  notes                    String?
  supervisorId             String?
  supervisor               User?             @relation("RunSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  supervisorName           String?
  supervisorApprovalStatus String            @default("none") // "none" | "pending" | "approved" | "rejected"
  supervisorApprovedAt     DateTime?
  supervisorNotes          String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  stepLogs                 WorkflowStepLog[]

  @@index([processId])
  @@index([operatorId])
  @@index([status])
}

model WorkflowStepLog {
  id                 String      @id @default(uuid())
  runId              String
  run                WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId             String?
  stepKey            String
  stepOrder          Int
  stepTitle          String
  status             String      @default("completed") // "completed" | "skipped" | "blocked"
  startedAt          DateTime?
  completedAt        DateTime    @default(now())
  durationSeconds    Int?
  operatorNotes      String?
  isCheckpoint       Boolean     @default(false)
  supervisorSignOff  Boolean     @default(false)
  supervisorSignedBy String?
  supervisorSignedAt DateTime?
  createdAt          DateTime    @default(now())

  @@index([runId])
  @@index([stepKey])
}

