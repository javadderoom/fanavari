# ========================================================
# Fanavari Platform - Environment Variables Template
# ========================================================

# --------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma 7 & PostgreSQL)
# --------------------------------------------------------
# Production (e.g. Neon Serverless Postgres with Connection Pooling):
# Add this variable in Vercel Dashboard -> Settings -> Environment Variables
DATABASE_URL="postgresql://neondb_owner:password@ep-quiet-mode-b2nt2owh-pooler.c-6.eu-central-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Direct URL for non-pooled connection if needed:
# DIRECT_URL="postgresql://neondb_owner:password@ep-quiet-mode-b2nt2owh.c-6.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Local Development (Docker PostgreSQL on isolated port 5433):
# DATABASE_URL="postgresql://fanavari:fanavaripassword@localhost:5433/fanavari?schema=public"

# --------------------------------------------------------
# 2. VERCEL BLOB STORAGE (WebP Image & Snippet Hosting)
# --------------------------------------------------------
# Generated automatically when connecting Blob Store in Vercel.
# For local development, copy from Vercel -> Storage -> Blob Store -> Settings (.env.local tab)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# --------------------------------------------------------
# 3. APPLICATION CONFIGURATION
# --------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://fanavari.vercel.app"
NODE_ENV="production"

# --------------------------------------------------------
# 4. AUTHENTICATION (Phone/Email Identity)
# --------------------------------------------------------
# Kavenegar SMS gateway for OTP delivery (Verify Lookup template with %token%).
# Without this key, OTP codes are only logged to the server console (dev).
KAVENEGAR_API_KEY=""
KAVENEGAR_TEMPLATE="fanavari-otp"
# Alias also accepted: KAVENEGAR_OTP_TEMPLATE=""

# Demo personas (localStorage user switcher). DENY-BY-DEFAULT: demo is OFF
# unless explicitly enabled — set to "true" for local development only.
# The server honors this same variable, so "true" enables BOTH the demo UI
# and the server's trust in demo x-user-* headers. Never enable in production.
NEXT_PUBLIC_ALLOW_DEMO_LOGIN="true"

# Optional explicit server-side flag with the same effect (either one set to
# "true" enables demo mode).
# ALLOW_DEMO_LOGIN="true"

# Email OTP delivery is log-only for now (see src/lib/email.ts).
# Plug a provider (Resend/SMTP) here when ready:
# EMAIL_PROVIDER=""
# RESEND_API_KEY=""

